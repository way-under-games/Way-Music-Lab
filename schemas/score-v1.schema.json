{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Way Music score v1",
  "type": "object",
  "required": ["schemaVersion", "generatorVersion", "ppq", "beatsPerBar", "startBar", "bars", "settings", "tracks", "harmony", "events"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatorVersion": { "type": "string" },
    "ppq": { "const": 480 },
    "beatsPerBar": { "const": 4 },
    "startBar": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "bars": { "type": "integer", "minimum": 1, "maximum": 256 },
    "settings": {
      "type": "object",
      "required": ["seed", "scene", "intensity", "tempo", "key", "muted"],
      "properties": {
        "seed": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "\\S" },
        "scene": { "enum": ["explore", "tension", "battle", "victory"] },
        "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
        "tempo": { "type": "number", "minimum": 40, "maximum": 200 },
        "key": { "enum": ["D", "E", "G", "A", "C"] },
        "muted": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/trackId" } }
      },
      "additionalProperties": false
    },
    "tracks": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {
        "type": "object", "required": ["id", "name", "channel", "program"],
        "properties": { "id": { "$ref": "#/$defs/trackId" }, "name": { "type": "string" }, "channel": { "type": "integer", "minimum": 0, "maximum": 15 }, "program": { "type": ["integer", "null"], "minimum": 0, "maximum": 127 } },
        "additionalProperties": false
      }
    },
    "harmony": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": { "type": "object", "required": ["bar", "rootMidi", "notes"], "properties": { "bar": { "type": "integer", "minimum": 0 }, "rootMidi": { "$ref": "#/$defs/midi" }, "notes": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/midi" } } }, "additionalProperties": false }
    },
    "events": {
      "type": "array", "maxItems": 100000,
      "items": { "type": "object", "required": ["id", "track", "startTick", "durationTicks", "midi", "velocity"], "properties": { "id": { "type": "string" }, "track": { "$ref": "#/$defs/trackId" }, "startTick": { "type": "integer", "minimum": 0 }, "durationTicks": { "type": "integer", "minimum": 1, "maximum": 1920 }, "midi": { "$ref": "#/$defs/midi" }, "velocity": { "type": "integer", "minimum": 1, "maximum": 127 } }, "additionalProperties": false }
    }
  },
  "$defs": { "trackId": { "enum": ["strings", "harp", "woodwind", "horn", "percussion"] }, "midi": { "type": "integer", "minimum": 0, "maximum": 127 } },
  "additionalProperties": false
}
